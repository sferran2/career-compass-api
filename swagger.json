        ],
        "responses": {
          "200": {
            "description": "Application retrieved successfully."
          },
          "400": {
            "description": "Invalid MongoDB ID format."
          },
          "404": {
            "description": "Application not found."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      },
      "put": {
